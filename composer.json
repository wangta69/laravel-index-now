{
  "name": "wangta69/laravel-index-now",
  "description": "Lightweight IndexNow & Google Indexing API integration for Laravel",
  "keywords": [
    "laravel",
    "index-now",
    "seo",
    "google-indexing",
    "search-engine"
  ],
  "homepage": "https://www.onstory.fun/packages/index-now",
  "license": "MIT",
  "authors": [
    {
      "name": "Pondol",
      "email": "wangta69@gmail.com",
      "homepage": "https://www.gilra.kr"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-openssl": "*",
    "illuminate/bus": "^11.0|^12.0|^13.0",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/queue": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Pondol\\IndexNow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pondol\\IndexNow\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pondol\\IndexNow\\IndexNowServiceProvider"
      ],
      "aliases": {
        "IndexNow": "Pondol\\IndexNow\\Facades\\IndexNow"
      }
    }
  }
}
